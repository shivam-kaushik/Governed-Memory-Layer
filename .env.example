# Atlas connection (readWrite on one database). Copy to .env
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=governed_memory

# Voyage AI rerank of recall candidates (optional; ranking only)
VOYAGE_API_KEY=
# Agent brain (without it the app falls back to the rule brain, which cannot learn)
ANTHROPIC_API_KEY=
# Vonage SMS alerts (all four required; otherwise alerts are off)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=GML
VONAGE_TO=
# Optional: GML_MODEL, GML_TICK_MS (default 8000), GML_AUTO=0 to disable the agent loop, GML_MANUAL=1 to start with manual controls
